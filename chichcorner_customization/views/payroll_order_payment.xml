<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the payslip tree view -->
    <record id="view_hr_payslip_tree_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.tree.inherit</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <header>
                <!-- Add new button to print our custom report -->
                <button name="action_print_custom_payslip"
                        string="Order De Virement"
                        type="object"
                        class="btn-success"/>
                <button name="action_print_bulletin_paie"
                        string="Bulletin de paie"
                        type="object"
                        class="btn-success"/>

            </header>
            <field name="net_wage" position="after">
                <field name="brut_imposable" string="Brut Imposable" sum="Total Brut Imposable"/>
                <field name="net_imposable" string="Net Imposable" sum="Total Net Imposable"/>
                <field name="cnss_total" string="CNSS" sum="Total CNSS"/>
                <field name="ir_brut" string="IR Brut" sum="Total IR Brut"/>
                <field name="jours_travailles" string="Jours Travaillés" sum="Total Jours"/>
                <field name="jours_conges" string="Jours Congé" sum="Total Congés"/>
            </field>
        </field>
    </record>
</odoo>
